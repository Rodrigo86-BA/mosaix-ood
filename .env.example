# =============================================================================
# MosAIx - VISAPP 2027.  Machine-local paths for replicating the paper figures.
# -----------------------------------------------------------------------------
# Copy to `.env`, fill in the paths for your machine, then run
#
#   $PYTHON_BIN configs/render_paths.py --check
#
# `--check` verifies every path exists and prints, per figure, whether that
# figure can be produced.  Without `--check` it renders `configs/paths.yaml`
# from `configs/paths.yaml.template`, which is the file the scripts read.
#
# `.env` is gitignored.  `.env.example` is not: it is the contract.
# Every variable below is marked with the figures that need it.
# =============================================================================

# -- Repository roots ---------------------------------------------------------
# MOSAIX_ROOT  the working repo, the one holding scripts/ results/ figures/.
#              Every script resolves its own ROOT as parents[1] of its file, so
#              this is only used by the tooling in configs/.
# XAI_OOD_ROOT the FROZEN source repo (reachable in MOSAIX_ROOT as the symlink
#              `external_xai_ood`).  Holds src/, configs/paths.yaml and the
#              frozen results/.  Read-only: never write into it.
MOSAIX_ROOT=/path/to/XAI_OOD_MOSAIC
XAI_OOD_ROOT=/path/to/XAI_OOD

# -- Datasets -----------------------------------------------------------------
# Root that contains every dataset tree below.
DATA_ROOT=/path/to/Data

# ImageNet-1K, preprocessed trees.  `se256` is the short-edge-256 training
# tree, loaded with pre=False so it takes Resize(256)+CenterCrop(224).
# Needed by: Fig. 2 (method), Fig. 4 (head refit), Tab. tab:field.
IN1K_TRAIN=${DATA_ROOT}/imagenet1k_pre/se256/train
# WARNING: `clean/val` is ALREADY 224x224 center-cropped on disk, and the code
# loads it with pre=True so the crop is skipped.  Cropping it again flips 16%
# of the predictions and no assertion catches that.  Point this at a raw
# validation tree only if you also flip the flag.  See README.md.
IN1K_VAL=${DATA_ROOT}/imagenet1k_pre/clean/val

# OpenOOD v1.5 suite for ImageNet-1K.
# near-OOD.  Needed by: Tab. tab:field, and by the CSVs behind Figs. 3, 5.
OOD_SSB_HARD=${DATA_ROOT}/ssb_hard
OOD_NINCO=${DATA_ROOT}/NINCO/NINCO/NINCO_OOD_classes
# far-OOD.
OOD_INATURALIST=${DATA_ROOT}/iNaturalist
OOD_OPENIMAGE_O=${DATA_ROOT}/openimage_o
OOD_TEXTURES=${DATA_ROOT}/dtd

# ImageNet-200 / RN-18.  Needed by: Fig. 6 (crossplot, left panel).
IM200_IMGLIST=${DATA_ROOT}/benchmark_imglist/imagenet200
IM200_RESIZED=/path/to/Imagenet200Train/data_resized256
IM200_RAW_VAL=${DATA_ROOT}/imagenet1k/Imagenet/val/ILSVRC2012_img_val
IM200_MODELS_ROOT=/path/to/MODELS/CURRICULUM_LS_FROM_SCRATCH/imagenet200

# CIFAR.  Needed by: Fig. 6 (crossplot, right panel).
# CIFAR_TORCHVISION_ROOT must hold cifar-10-batches-py and cifar-100-python.
CIFAR_TORCHVISION_ROOT=${DATA_ROOT}
CIFAR_TIN_TRAIN=${DATA_ROOT}/Tiny_imagenet/train
CIFAR100_MODELS_ROOT=/path/to/MODELS/CURRICULUM_LS_FROM_SCRATCH/cifar100

# -- Checkpoints: RN-50 ImageNet-1K, trained from scratch ---------------------
# Three losses, one recipe, seed 0.  Plain state-dicts (`last.pt`); the
# sibling `log.json` carries the hyperparameters.  Validation top-1 is
# hard-coded in scripts/07 (TOP1) and must match these files.
# Needed by: Fig. 1 (teaser), Fig. 2 (method), Fig. 4 (head refit, ce+ls only),
#            Fig. 5 (ablations, via the frozen CSVs).
# Only the CE variables below are read straight from the environment. LS and
# MIXUP reach the scripts through configs/paths.yaml, so after changing them
# you have to re-render that file (configs/render_paths.py).
# Download:
#   https://drive.google.com/drive/folders/1KFOULKRAiJyvdVRWMaBMvPscxtG2RHHs?usp=sharing
# The download has one subfolder per checkpoint, laid out as below.  See
# README.md, "Downloading the checkpoints".
CE_CKPT=/path/to/mosaix_checkpoints/resnet50_full_ce_s0/last.pt
LS_CKPT=/path/to/mosaix_checkpoints/resnet50_full_ls_standard_a0.1_s0/last.pt
MIXUP_CKPT=/path/to/mosaix_checkpoints/resnet50_mixup1.0_s0/last.pt

# Curated GAP features for the same three backbones (raw GAP, ImageFolder row
# order, reproduces the logits).  Feature-based detectors are fit on these.
CE_FEATDIR=/path/to/Pooled_features/Curated_pooled_features/imagenet1k/trainFromScratch/resnet50/resnet50_full_ce_s0
LS_FEATDIR=/path/to/Pooled_features/Curated_pooled_features/imagenet1k/trainFromScratch/resnet50/resnet50_full_ls_standard_a0.1_s0
MIXUP_FEATDIR=/path/to/Pooled_features/Curated_pooled_features/imagenet1k/trainFromScratch/resnet50/resnet50_mixup1.0_s0

# -- Checkpoints: torchvision, downloaded automatically -----------------------
# Tab. tab:field and scripts 164/167/168 use the PUBLIC torchvision
# weights, not the from-scratch ones: ResNet50_Weights.IMAGENET1K_V1 and
# ViT_B_16_Weights.IMAGENET1K_V1.  No path is needed; set TORCH_HOME if you
# want the download cached somewhere specific.
TORCH_HOME=/path/to/.cache/torch

# -- Optional overrides -------------------------------------------------------
# CE_TOP1 relaxes the validation top-1 gate in shared_code. The loader refuses a
# checkpoint whose accuracy is more than 0.002 away from the expected value, so
# set this only when you deliberately swap the CE checkpoint for another seed.
# The three checkpoints shipped here read 0.75624 (CE), 0.76382 (LS) and
# 0.75372 (mixup).
CE_TOP1=

# PROTO_IDX_NPY replaces the prototype index array with one of your own. Leave
# it empty to use the centroid policy the paper uses.
PROTO_IDX_NPY=

# -- Python -------------------------------------------------------------------
# The interpreter every script is run with.
PYTHON_BIN=/path/to/dl_env/bin/python

# Tiny-ImageNet words.txt, used only to print short class names in Fig. 1.
# Optional: without it the figure falls back to the raw wnid.
TIN_WORDS=${DATA_ROOT}/Tiny_imagenet/words.txt

# -- Camera-ready additions (camera_ready_code/) -------------------------------
# Raw ImageNet-1K training tree with wnid folders (Fig. 7, the ViT schematic).
IN1K_RAW_TRAIN=${DATA_ROOT}/imagenet1k/Imagenet/train
# Cached GAP features of the torchvision ResNet-50 V2 checkpoint (Table 8).
# Optional: defaults to a sibling of LS_FEATDIR named torchvision/resnet50_v2.
V2_FEATDIR=/path/to/Pooled_features/Curated_pooled_features/imagenet1k/torchvision/resnet50_v2
# Reference CE-only head for the V2 checkpoint, a state dict with weight and
# bias. Needed only by camera_ready_code/tab8_refit_head_sgd.py --key v2.
V2_REF_CE_HEAD=/path/to/v2_ce_only_head.pth
# Optional: overrides the torchvision feature directory used by the working
# repository's scripts/64 (Table 8 V2 runs and the RN-18 ViM row).
TV_FEAT_ROOT=
# Optional, Fig. 6 only: set to 1 to skip the check that nothing falls outside
# the canvas.
CR_NOCHECK=
